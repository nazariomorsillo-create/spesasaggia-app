# Porta del server (dietro nginx in produzione)
PORTA=3200
# Facoltativa: la stessa chiave Google Maps della Segretaria. Senza, gli indirizzi si cercano su OpenStreetMap.
GOOGLE_MAPS_KEY=
# Facoltativo: un altro server Overpass (OpenStreetMap) da provare per primo per i supermercati vicino a casa
OVERPASS_URL=

# Numeri di cellulare degli amministratori, separati da virgola
ADMIN=
# WhatsApp dell'app (vedi ecosystem-whatsapp.config.cjs): consigliato
WHATSAPP_SERVIZIO=
# 0.98: avvisi WhatsApp per le offerte dei preferiti (spenti: arrivavano a raffica a ogni volantino). 1 per riaccenderli
AVVISI_OFFERTE_WHATSAPP=0
# In alternativa: ponte WhatsApp della Segretaria
WHATSAPP_PONTE_URL=
WHATSAPP_PONTE_SEGRETO=
# Chi tratta i dati (pagina Privacy)
TITOLARE=
# Lettura dei volantini con Claude (console.anthropic.com → API Keys). Senza, i volantini si raccolgono ma non si leggono.
ANTHROPIC_API_KEY=
# Facoltativi: il modello e la stima del costo in euro per milione di token (letti / scritti)
CLAUDE_MODELLO=claude-sonnet-5-5
CLAUDE_EURO_MTOK_IN=3
CLAUDE_EURO_MTOK_OUT=15

# Orari dei negozi: si aggiornano da soli ogni giorno (mappa e sito). Metti 0 per spegnere.
# ORARI_AUTOMATICI=1

# Costo stimato di una ricerca web di Claude (orari dei negozi), in euro. Predefinito 0.01
# CLAUDE_EURO_RICERCA=0.01

# Ricerca degli orari su internet con Claude: SPENTA (costa 5-10 centesimi a negozio). Metti 1 per accenderla.
# ORARI_WEB=0
# Quanti negozi al giorno cercare, se accesa. Predefinito 8
# ORARI_WEB_AL_GIORNO=8
